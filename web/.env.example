# ============================================================================
# HeyHank — Environment Variables
# ----------------------------------------------------------------------------
# Copy to .env and fill in only what you actually use. Everything is optional;
# HeyHank starts with sensible defaults and auto-generates an auth token on
# first run (~/.heyhank/auth.json).
#
# Variables fall into three groups:
#   1. Core server     — basic runtime knobs
#   2. LLM providers   — at least one is required to talk to a model
#   3. Optional features — Voice/Telephony, Federation, Codex, Tailscale, …
# ============================================================================

# ---------------- 1. Core server ----------------
# Port the HeyHank web UI listens on (default 3456)
PORT=3456
# HOST=0.0.0.0
# NODE_ENV=production

# Override the auto-generated auth token (otherwise read from ~/.heyhank/auth.json)
# HEYHANK_AUTH_TOKEN=
# HEYHANK_AUTH_ENABLED=true
# HEYHANK_AUTH_SECRET=

# Override config / data locations (defaults: ~/.heyhank, $TMPDIR/vibe-sessions)
# HEYHANK_HOME=
# HEYHANK_SESSION_DIR=
# HEYHANK_LOG_DIR=
# HEYHANK_LOG_FILE=
# HEYHANK_LOG_FORMAT=text          # text | json
# HEYHANK_LOG_MAX_LINES=100000

# Raw protocol recording (NDJSON of every CLI<->browser message)
# HEYHANK_RECORD=1                 # 0 or false to disable
# HEYHANK_RECORDINGS_DIR=
# HEYHANK_RECORDINGS_MAX_LINES=1000000

# Session lifecycle tuning
# HEYHANK_IDLE_KILL_MINUTES=120
# HEYHANK_RECONNECT_GRACE_MS=10000
# HEYHANK_DISCONNECT_DEBOUNCE_MS=2000
# HEYHANK_INIT_SCRIPT_TIMEOUT=120000
# HEYHANK_HUB_MAX_UPLOAD_MB=10
# HEYHANK_LOGIN_URL=

# ---------------- 2. LLM providers (pick what you use) ----------------
# Anthropic / Claude (Claude Code CLI is the primary backend)
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_PROJECTS_DIR=

# OpenAI / Codex CLI (secondary backend)
# OPENAI_API_KEY=
# CODEX_HOME=

# Google Gemini (used by Gemini Live voice assistant + memory embeddings)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_BACKEND=

# OpenRouter (alternative provider in Hank-UI)
# OPENROUTER_API_KEY=

# ---------------- 3. Optional features ----------------
# --- Voice Pipeline / Calendar (Google Cloud) ---
# Required only for the low-latency telephony Voice Pipeline (STT/TTS) and
# Google Calendar integration. Create a service account with Speech & Calendar
# scopes and either point at the JSON file or paste it inline.
# GCP_PROJECT_ID=
# GCP_LOCATION=europe-west1
# GCP_SERVICE_ACCOUNT_KEY=/absolute/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# --- Codex transport (only if you use Codex CLI) ---
# HEYHANK_CODEX_TRANSPORT=stdio    # stdio | ws
# HEYHANK_CODEX_CONTAINER_WS_PORT=
# HEYHANK_CODEX_PONG_TIMEOUT_MS=
# HEYHANK_CODEX_WS_CONNECT_TIMEOUT_MS=

# --- Federation (multi-node HeyHank mesh via relay) ---
# HEYHANK_RELAY_URL=wss://relay.example.com
# HEYHANK_RELAY_SECRET=

# --- Tailscale Funnel (public HTTPS without port forwarding) ---
# HEYHANK_TAILSCALE_CLEANUP_ON_EXIT=true

# --- Container / sandbox mode (advanced) ---
# HEYHANK_FORCE_BYPASS_AS_ROOT=
# HEYHANK_FORCE_BYPASS_IN_CONTAINER=
# HEYHANK_CONTAINER_SDK_HOST=
# HEYHANK_EDITOR_PORT=

# --- Experimental ---
# CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# ---------------- Frontend (build-time, Vite) ----------------
# Used only when you build the dashboard yourself. Safe to leave blank.
# VITE_POSTHOG_KEY=phc_your_project_key
# VITE_POSTHOG_HOST=https://us.i.posthog.com
